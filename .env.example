# Configuração local na raiz: copie para .env e preencha uma vez.
# pnpm dev e comandos *:local carregam .env, depois .env.local.
# Shell/CI prevalece, inclusive valores vazios. Não use source.
# Produção e testes exigem configuração explícita; veja docs/authentication.md.
# Nunca versione credenciais reais.
# Formato: postgresql://USUARIO:SENHA_URL_ENCODED@127.0.0.1:5432/BANCO
DATABASE_URL=
# Gere e salve uma única vez, com no mínimo 32 bytes.
BUNKERCODE_JWT_SECRET=
BUNKERCODE_JWT_ISSUER=bunkercode-local
BUNKERCODE_JWT_AUDIENCE=bunkercode-web
BUNKERCODE_AUTH_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5184,http://127.0.0.1:5186
BUNKERCODE_STUDIO_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
PORT=3001

# Opcional em authoring: seleção explícita alternativa; default config/publication.json.
# BUNKERCODE_PUBLICATION_FILE=/caminho/absoluto/publication.json

# Opcionais: limites compartilhados no PostgreSQL; janelas e dimensões em docs/authentication.md.
# BUNKERCODE_AUTH_LOGIN_IP_LIMIT=120
# BUNKERCODE_AUTH_REGISTER_IP_LIMIT=60
# Proxy apenas se administrado e validado. Sem configuração, X-Forwarded-For é ignorado.
# BUNKERCODE_TRUSTED_PROXIES=127.0.0.1/32
