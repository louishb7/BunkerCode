generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  username     String?   @unique @db.VarChar(30)
  passwordHash String
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @db.Char(64)
  previousHash String?   @unique @db.Char(64)
  rotatedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Shared, expiring authentication counters; keys are keyed digests, not identifiers.
model AuthThrottle {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
