{
  "name": "@bunkercode/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && BUNKERCODE_PROFILE=authoring tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node ../../scripts/copy-sql-runner.mjs",
    "start": "node ../../scripts/deploy-backend.mjs",
    "test": "pnpm build && BUNKERCODE_PROFILE=authoring tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "start:authoring": "BUNKERCODE_PROFILE=authoring node dist/main.js",
    "start:public": "BUNKERCODE_PROFILE=public node ../../scripts/deploy-backend.mjs",
    "db:generate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "prisma migrate deploy",
    "sql:recover": "node dist/sql/recover.js",
    "admin:grant": "tsx src/auth/provision-admin.ts",
    "db:deploy:local": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:status:local": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local node_modules/prisma/build/index.js migrate status",
    "admin:grant:local": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/auth/provision-admin.ts"
  },
  "dependencies": {
    "@bunkercode/content": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.2.1",
    "jose": "6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.3",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0"
  }
}
