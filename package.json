{
  "name": "backendlab",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n api,web -c cyan,green \"pnpm --filter @backendlab/api dev\" \"pnpm --filter @backendlab/web dev\"",
    "build:packages": "pnpm --filter @backendlab/protocol --filter @backendlab/lab-sdk --filter @backendlab/lab-001 build",
    "build": "pnpm -r --if-present build",
    "test": "pnpm build:packages && pnpm --filter @backendlab/api test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
