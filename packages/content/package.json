{
  "name": "@bunkercode/content",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "default": "./dist/authoring.js"
    }
  },
  "typesVersions": {
    "*": {
      "authoring": [
        "dist/authoring.d.ts"
      ]
    }
  }
}
