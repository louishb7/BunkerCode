{
  "name": "@bunkercode/content",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "default": "./dist/authoring.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    },
    "./sql-engine": {
      "types": "./dist/sql-engine.d.ts",
      "default": "./dist/sql-engine.js"
    },
    "./sql-grading": {
      "types": "./dist/sql-grading.d.ts",
      "default": "./dist/sql-grading.js"
    },
    "./sql-comparison": {
      "types": "./dist/sql-comparison.d.ts",
      "default": "./dist/sql-comparison.js"
    }
  },
  "typesVersions": {
    "*": {
      "authoring": [
        "dist/authoring.d.ts"
      ],
      "manifest": [
        "dist/manifest.d.ts"
      ],
      "sql": [
        "dist/sql.d.ts"
      ],
      "sql-engine": [
        "dist/sql-engine.d.ts"
      ],
      "sql-grading": [
        "dist/sql-grading.d.ts"
      ],
      "sql-comparison": [
        "dist/sql-comparison.d.ts"
      ]
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
